{
  "expo": {
    "name": "Soloist",
    "slug": "soloist",
    "scheme": "soloist",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1117",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.soloist.app",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Soloist listens to your instrument to grade your timing and pitch. Nothing is recorded or uploaded.",
        "NSLocalNetworkUsageDescription": "Soloist downloads lessons from the Soloist server on your computer.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.soloist.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e1117"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0e1117"
        }
      ],
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:4000"
    }
  }
}
